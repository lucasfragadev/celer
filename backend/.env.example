# Ambiente da API Celer
# Copie este arquivo para .env e preencha os valores reais

# Porta onde a API Node.js vai rodar
PORT=3333

# String de conexão com o PostgreSQL
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://celer_user:celer_pass@localhost:5432/celer_db

# Segredo para assinar os tokens JWT — use uma string longa e aleatória em produção
JWT_SECRET=troque-por-uma-string-secreta-longa-em-producao

# Tempo de expiração do token JWT (ex: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# Ambiente de execução
NODE_ENV=development
